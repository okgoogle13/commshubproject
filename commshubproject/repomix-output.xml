    # Step 8: Approval token is consumed — can't re-use it
    with pytest.raises(PermissionError):
        sender.send_message(inbound_handle, drafts["honest"], "acc_test_001", "honest", token)

    print("[ACCEPTANCE] Milestone 1 test PASSED.")
